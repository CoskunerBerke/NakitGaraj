# NAKİTGARAJ PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT ACTUAL SECRET KEYS OR TOKENS TO GIT!

PORT=3001
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_super_secret_random_jwt_key_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=your_telegram_chat_id_here
# Galeri WhatsApp numarasi (dagitima ozel). Bos birakilirsa Telegram
# bildirimlerindeki "Yetkiliye Ilet" butonu HIC EKLENMEZ.
# Ornek bicim: 05XXXXXXXXX
GALLERY_WHATSAPP_PHONE=

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Redis Cache (Optional for high traffic)
REDIS_HOST=localhost
REDIS_PORT=6379
