# NAKİTGARAJ PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT ACTUAL SECRET KEYS OR TOKENS TO GIT!

PORT=3001
NODE_ENV=production

# --- REQUIRED IN PRODUCTION ---

# JWT Authentication Secret (min 24 chars; app refuses to start with
# missing/placeholder/short values in production)
JWT_SECRET=your_super_secret_random_jwt_key_here

# Admin bootstrap (required by `prisma db seed` in production; known default
# passwords are rejected, min 12 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=set_a_unique_password_here

# Database Connection (SQLite path is resolved relative to prisma/schema.prisma;
# use an absolute file: path in production so deploys never overwrite data,
# e.g. DATABASE_URL="file:/var/lib/nakitgaraj/prod.db")
DATABASE_URL="file:./dev.db"

# CORS allow-list (comma separated origins; REQUIRED in production, otherwise
# only localhost origins are allowed)
ALLOWED_ORIGINS=https://www.example.com

# --- OPTIONAL ---

# Telegram Bot Integration (server-side only; never expose to the frontend)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=your_telegram_chat_id_here
# Galeri WhatsApp numarasi (dagitima ozel). Bos birakilirsa Telegram
# bildirimlerindeki "Yetkiliye Ilet" butonu HIC EKLENMEZ.
# Ornek bicim: 05XXXXXXXXX
GALLERY_WHATSAPP_PHONE=

# Global API throttling (defaults: 120 requests / 60000 ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Redis Cache (Optional for high traffic)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- FRONTEND (frontend/.env.production; NEVER put secrets in NEXT_PUBLIC_*) ---
# NEXT_PUBLIC_API_URL=https://www.example.com/api
