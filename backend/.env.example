# NAKİTGARAJ PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT ACTUAL SECRET KEYS OR TOKENS TO GIT!

PORT=3001
NODE_ENV=production

# JWT Authentication Secret (REQUIRED - the backend refuses to start without it,
# and refuses placeholder values such as "change-me" when NODE_ENV=production)
# Generate a random value, e.g.: openssl rand -hex 32
JWT_SECRET=

# Initial admin account created by `npx prisma db seed`
# ADMIN_PASSWORD is REQUIRED for seeding (no default password).
ADMIN_EMAIL=admin@nakitgaraj.com
ADMIN_PASSWORD=

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=your_telegram_chat_id_here
GALLERY_WHATSAPP_PHONE=05350379074

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Redis Cache (Optional for high traffic)
REDIS_HOST=localhost
REDIS_PORT=6379
