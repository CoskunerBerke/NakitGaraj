# NAKİTGARAJ BACKEND ENVIRONMENT TEMPLATE
# Copy to backend/.env and fill in. DO NOT COMMIT ACTUAL SECRET KEYS OR TOKENS TO GIT!

PORT=3001
# "development" for local runs. On servers use "production" (the PM2 config
# ecosystem.config.js already sets it); it enables the JWT placeholder check.
NODE_ENV=development

# JWT Authentication Secret (REQUIRED - the backend refuses to start without it,
# and refuses placeholder values such as "change-me" when NODE_ENV=production)
# Generate a random value, e.g.: openssl rand -hex 32
JWT_SECRET=

# Browser origins allowed to call the API from another site, comma-separated
# (e.g. https://your-domain.com). Empty: with NODE_ENV=production no
# cross-origin requests are allowed (the site calls the API on the same
# origin through Nginx /api); in development every origin is allowed.
CORS_ORIGIN=

# Initial admin account created by `npx prisma db seed`
# ADMIN_PASSWORD is REQUIRED for seeding (no default password).
ADMIN_EMAIL=admin@nakitgaraj.com
ADMIN_PASSWORD=

# Telegram notifications (optional). Used to create telegram-settings.json on
# first start; afterwards they can be changed in the admin panel (API Ayarları).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Gallery WhatsApp number for the "Yetkiliye İlet" button, e.g. 05XXXXXXXXX
GALLERY_WHATSAPP_PHONE=

# Redis cache (optional). Without Redis an in-memory cache is used.
# REDIS_URL=redis://localhost:6379

# Listing scraper proxies (optional), e.g. http://user:pass@host:port
# SCRAPER_PROXY=
# SCRAPER_PROXIES=

# Note: the database is SQLite at prisma/dev.db (set in prisma/schema.prisma);
# DATABASE_URL is not read at the moment.

# Optional: local folder with saved listing pages (one sub-folder per brand)
# used by the data-import scripts in src/scripts. When set, the brand list in
# the valuation wizard only shows brands that have a folder there.
# LISTING_ARCHIVE_DIR=
